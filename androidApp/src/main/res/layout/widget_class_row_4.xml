<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/academic_widget_row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="9dp" android:background="@drawable/widget_card_4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/academic_widget_row_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/academic_widget_text" android:textStyle="bold" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_row_relative" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:paddingStart="4dp" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/academic_widget_row_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/academic_widget_secondary" android:textSize="12sp" android:paddingTop="3dp" android:maxLines="1" android:ellipsize="end"/>
    <ProgressBar android:id="@+id/widget_row_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp"
        android:layout_marginTop="5dp" android:indeterminate="false" android:progressDrawable="@drawable/widget_progress_4" android:visibility="gone"/>
</LinearLayout>
