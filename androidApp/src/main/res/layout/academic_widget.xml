<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/academic_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/academic_widget_background">
    <TextView android:id="@+id/academic_widget_title" android:layout_width="match_parent" android:layout_height="24dp"
        android:text="@string/academic_widget_preview_title" android:textColor="@color/academic_widget_text" android:textStyle="bold"
        android:textSize="18sp" android:layout_marginBottom="8dp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/academic_widget_body" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/academic_widget_summary" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.52" android:textSize="12sp" android:textStyle="bold" android:paddingEnd="3dp"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" android:maxLines="2"
            android:textColor="@color/academic_widget_text" android:visibility="gone" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.48">
            <ListView android:id="@+id/academic_widget_list" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="@android:color/transparent" android:dividerHeight="3dp" android:scrollbars="none" />
            <TextView android:id="@+id/academic_widget_empty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:text="@string/academic_widget_preview_empty"
                android:textSize="11sp" android:textColor="@color/academic_widget_secondary" />
        </FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/academic_widget_grid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="fitXY" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_weekend_section" android:layout_width="match_parent" android:layout_height="88dp"
        android:orientation="vertical" android:visibility="gone">
       <ListView android:id="@+id/widget_weekend_list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="none" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/academic_widget_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center_vertical" android:textSize="11sp" android:textColor="@color/academic_widget_secondary" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/academic_widget_refresh" android:layout_width="24dp" android:layout_height="24dp"
            android:padding="4dp" android:background="@android:color/transparent" android:src="@drawable/widget_refresh"
            android:contentDescription="일정 즉시 업데이트" android:tint="@color/academic_widget_secondary" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
