// 커밋되는 공유 기본값. Team ID 등 로컬 값은 Config.local.xcconfig에서만 덮어쓴다.
TEAM_ID=

PRODUCT_NAME=kw-klas-plus
PRODUCT_BUNDLE_IDENTIFIER=com.icecream.kwklasplus.kw-klas-plus$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// iOS·iPadOS 최소 지원 버전
IPHONEOS_DEPLOYMENT_TARGET=16.0

#include? "Config.local.xcconfig"
