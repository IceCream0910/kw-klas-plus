// 이 파일을 같은 디렉터리의 Config.local.xcconfig로 복사한 뒤 로컬 값만 채운다.
// Config.local.xcconfig는 .gitignore 대상이며 커밋하지 않는다.
//
// Apple Developer Team ID (Xcode → Signing & Capabilities의 Team)
TEAM_ID = YOUR_TEAM_ID

// 배포 팀이 아닌 개인 팀으로 실기기 테스트할 때만 주석을 풀고 자신의 팀에 등록한 값으로 바꾼다.
// 위젯·테스트 Bundle ID는 APP_BUNDLE_IDENTIFIER 뒤에 .libraryqr/.tests/.uitests가 붙는다.
// APP_BUNDLE_IDENTIFIER = com.example.kwklasplus
// APP_GROUP_IDENTIFIER = group.com.example.kwklasplus
